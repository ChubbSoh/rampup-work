    {
      "id": "node-hash-pii",
      "name": "Hash PII for CAPI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\n\nfunction sha256(val) {\n  return crypto.createHash('sha256').update((val || '').trim().toLowerCase()).digest('hex');\n}\n\n/**\n * Meta matches phones in E.164 digits with no punctuation or plus.\n * A Thai mobile must be 66812345678 — hashing \"081-234-5678\" as typed produces\n * a digest that can never match anything, which is what this used to do.\n */\nfunction normalizePhone(raw) {\n  let d = (raw || '').replace(/\\D/g, '');\n  if (!d) return '';\n  if (d.startsWith('0066')) d = d.slice(2);         // 0066... dial-out prefix\n  if (d.startsWith('66')) return d;                 // already country-coded\n  if (d.startsWith('0')) return '66' + d.slice(1);  // 08X... -> 668X...\n  if (d.length === 9) return '66' + d;              // bare 8XXXXXXXX\n  return d;                                          // foreign number, leave it\n}\n\nconst lead = $('Normalize Fields').first().json;\nconst eventId = lead.event_id || ('lead_' + Date.now());\nconst submittedMs = new Date(lead.submitted_at || new Date()).getTime();\nconst eventTime = Math.floor(Math.min(submittedMs, Date.now()) / 1000);\n\n// Only send signals we actually have. Hashing '' yields a valid-looking digest\n// that matches nobody and drags Event Match Quality down.\nconst userData = {};\nconst parts = (lead.name || '').trim().split(/\\s+/).filter(Boolean);\nconst firstName = parts[0] || '';\nconst lastName = parts.slice(1).join(' ');\nconst phone = normalizePhone(lead.phone);\n\nif (lead.email) userData.em = [sha256(lead.email)];\nif (phone)      userData.ph = [sha256(phone)];\nif (firstName)  userData.fn = [sha256(firstName)];\nif (lastName)   userData.ln = [sha256(lastName)];\n\n// These four are sent RAW — hashing them breaks the match.\nif (lead.client_ip_address) userData.client_ip_address = lead.client_ip_address;\nif (lead.client_user_agent) userData.client_user_agent = lead.client_user_agent;\nif (lead.fbp) userData.fbp = lead.fbp;\nif (lead.fbc) userData.fbc = lead.fbc;\n\nreturn [{\n  json: {\n    data: JSON.stringify([{\n      event_name: 'Lead',\n      event_time: eventTime,\n      event_id: eventId,\n      event_source_url: lead.page_url || '',\n      action_source: 'website',\n      user_data: userData\n    }])\n  }\n}];"
      }
    },
