    {
      "id": "node-normalize",
      "name": "Normalize Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $json.body || $json;\n\nconst clean = (v) => (v ?? '').toString().trim();\n\n// lead_id: L-{YYYYMMDD}-{6 lowercase alphanumeric}, Asia/Bangkok date.\n// Reuse an incoming lead_id so a retry does not mint a second key.\nfunction makeLeadId() {\n  const bkk = new Date(Date.now() + 7 * 60 * 60 * 1000);\n  const ymd = bkk.toISOString().slice(0, 10).replace(/-/g, '');\n  const alphabet = 'abcdefghijklmnopqrstuvwxyz0123456789';\n  let s = '';\n  for (let i = 0; i < 6; i++) s += alphabet[Math.floor(Math.random() * alphabet.length)];\n  return `L-${ymd}-${s}`;\n}\n\n// Spread FIRST so anything the site adds later survives — lead_type, fbclid,\n// gclid, the utm_* params, language. Rebuilding from a fixed whitelist here is\n// what silently dropped those; do not reintroduce one.\nconst out = {\n  ...b,\n  lead_id:           clean(b.lead_id) || makeLeadId(),\n  lead_type:         clean(b.lead_type) || 'sales',\n  name:              clean(b.name),\n  restaurant:        clean(b.restaurant),\n  email:             clean(b.email).toLowerCase(),\n  phone:             clean(b.phone),\n  service:           clean(b.service),\n  message:           clean(b.message),\n  grab_revenue:      clean(b.grab_revenue),\n  grab_ads:          clean(b.grab_ads),\n  timeline:          clean(b.timeline),\n  restaurant_type:   clean(b.restaurant_type),\n  main_goal:         clean(b.main_goal),\n  page_path:         clean(b.page_path),\n  page_url:          clean(b.page_url),\n  page_type:         b.page_type    || 'other',\n  form_name:         b.form_name    || 'lead',\n  submitted_at:      b.submitted_at || new Date().toISOString(),\n  source:            b.source       || 'website',\n  site:              b.site         || 'rampupth',\n  event_id:          b.event_id           || '',\n  client_ip_address: b.client_ip_address  || '',\n  client_user_agent: b.client_user_agent  || '',\n  fbp:               b.fbp || '',\n  fbc:               b.fbc || '',\n};\n\n// Already verified by /api/lead-relay. Never forward it.\ndelete out.turnstile_token;\n\nreturn [{ json: out }];"
      }
    },
